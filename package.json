{
  "name": "friendly-pokemon-tournaments-pokedex",
  "private": true,
  "version": "1.0.0",
  "description": "Static Pokemon tournament prep site for GitHub Pages.",
  "scripts": {
    "build": "node ./scripts/build-pokedex-data.js",
    "build:pokedex": "node ./scripts/build-pokedex-data.js",
    "change:cost": "node ./scripts/change-pokemon-cost.js",
    "import:draft": "node ./scripts/import-draft-to-spieler.js",
    "import:replays": "node ./scripts/build-default-replay.js && node ./scripts/import-replays.js",
    "build:default-replay": "node ./scripts/build-default-replay.js",
    "validate:data": "node ./tools/validate-data.js",
    "start": "npx serve ."
  }
}
